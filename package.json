{
  "name": "flare-stack-blog",
  "version": "1.5.2",
  "type": "module",
  "author": {
    "email": "kuangdadu@gmail.com",
    "name": "akuang",
    "url": "https://github.com/du2333"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun scripts/generate-manifest.ts && vite build",
    "deploy": "bun db:migrate && wrangler deploy",
    "serve": "vite preview",
    "test": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "check": "biome check --write && bun typecheck",
    "i18n:compile": "bun paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "i18n:verify": "bun scripts/verify-translations.ts",
    "i18n:prune-unused": "bun scripts/prune-unused-translations.ts",
    "wrangler:prepare": "bun scripts/prepare-wrangler-config.ts",
    "cf-typegen": "wrangler types --env-interface Env",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/safe-d1-migrate/main.ts",
    "db:migrate:local": "bun scripts/safe-d1-migrate/main.ts --local",
    "db:migrate:unsafe": "wrangler d1 migrations apply DB --remote",
    "auth:generate-schema": "bunx @better-auth/cli generate --config auth-cli.ts --output src/lib/db/schema/auth.table.ts",
    "mcp:inspect": "bunx -y @modelcontextprotocol/inspector",
    "create-theme": "bun scripts/create-theme.ts",
    "release": "export GITHUB_TOKEN=$(gh auth token) && release-it",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/core": "1.7.1",
    "@better-auth/utils": "0.5.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "^2.3.0",
    "@orama/orama": "^3.1.18",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-query": "^5.102.4",
    "@tanstack/react-query-devtools": "^5.102.4",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/router-plugin": "^1.168.35",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-blockquote": "^3.30.3",
    "@tiptap/extension-code-block": "^3.30.3",
    "@tiptap/extension-file-handler": "^3.30.3",
    "@tiptap/extension-heading": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-mathematics": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/extension-table-cell": "^3.30.3",
    "@tiptap/extension-table-header": "^3.30.3",
    "@tiptap/extension-table-of-contents": "^3.30.3",
    "@tiptap/extension-table-row": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/static-renderer": "^3.30.3",
    "agents": "^0.21.0",
    "ai": "^7.0.79",
    "better-auth": "1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "feed": "^6.0.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.5",
    "katex": "^0.18.4",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.10.1",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.11",
    "tw-animate-css": "^1.4.0",
    "worker-mailer": "^1.2.1",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@cloudflare/vite-plugin": "^1.54.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "fallow": "^3.18.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "release-it": "^21.0.2",
    "shiki": "^4.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
